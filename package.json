{
  "name": "hdcommunity-toolkit",
  "version": "0.2.0",
  "description": "Agent toolkit for Huawei Cloud Community — MCP tools and Skills for community blogs (author/review/promote), the developer growth center (tasks/points/coupons + management-console change-request approval), and read-only data exposure.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/huaweicloud-mate/hdcommunity-toolkit.git"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "plugin.json",
    "mcp.json",
    ".claude-plugin",
    ".codex-plugin"
  ],
  "bin": {
    "hdcommunity-toolkit": "bin/setup.cjs",
    "hdcommunity-toolkit-mcp": "src/mcp-server.mjs"
  },
  "scripts": {
    "start": "node ./src/mcp-server.mjs",
    "smoke": "node ./scripts/smoke.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "undici": "^8.11.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "huaweicloud",
    "huawei-cloud",
    "community",
    "blog",
    "growth",
    "grow",
    "points",
    "coupon",
    "agent",
    "mcp",
    "skills",
    "opencode",
    "codex",
    "codearts"
  ],
